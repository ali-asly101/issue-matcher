# Copy to .env and fill in. .env is git-ignored. Never commit real tokens.

# GitHub fine-grained token: "Public repositories (read-only)" is enough for solo mode.
GITHUB_TOKEN=

# Needed from milestone M6 (LLM difficulty estimates).
ANTHROPIC_API_KEY=

# Team mode (S3), not used yet.
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# Override any tunable from src/issuematch/config.py with the ISSUEMATCH_ prefix, e.g.:
# ISSUEMATCH_TOP_N=10
